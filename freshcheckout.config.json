{
  "version": 1,
  "workingDirectory": "apps/freshcheckout",
  "commands": {
    "install": {
      "executable": "npm",
      "args": ["ci"]
    },
    "test": {
      "executable": "npm",
      "args": ["test"]
    },
    "build": {
      "executable": "npm",
      "args": ["run", "build"]
    },
    "start": {
      "executable": "node",
      "args": ["node_modules/tsx/dist/cli.mjs", "src/server/index.ts", "--host", "0.0.0.0", "--port", "4317"]
    }
  },
  "port": 4317,
  "assertion": {
    "text": "Your CI tests the codebase"
  }
}
